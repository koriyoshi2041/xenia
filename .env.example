# Chain: deploy after funding the relayer with Base Sepolia ETH.
RPC_URL=https://sepolia.base.org
RELAYER_PRIVATE_KEY=
ADJUDICATOR_PRIVATE_KEY=
COMMUNITY_KEYS_PATH=secrets/communities.json
GFH_REPOSITORIES=
POOL_ADDRESS=
GFH_OPERATOR_ADDRESS=
GFH_DEPLOYMENT_BLOCK=

# API. Set independent random values for these two secrets.
GFH_ADMIN_TOKEN=
GITHUB_WEBHOOK_SECRET=
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DATABASE_PATH=./server/gfh.sqlite
GFH_MODE=base-sepolia

# GitHub App enables private-repository reads and writes the required check run.
# App permissions: Contents write, Pull requests write, Checks write, Metadata read.
# Write access also allows this App's bot identity to open the demonstration PRs.
# Subscribe to Pull request events; deliver to PUBLIC_BASE_URL/webhooks/github.
GITHUB_APP_ID=
GITHUB_APP_NAME=Xenia
GITHUB_APP_PRIVATE_KEY_PATH=
# Optional token for read-only development when no GitHub App is configured.
GITHUB_TOKEN=

# Agent / MCP. The agent signs with its own account; relayer pays transaction gas.
GFH_API=http://localhost:8787
GFH_AGENT_KEY=
GFH_AGENT_ID=
GFH_GITHUB_LOGIN=
